{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "velard-tools.vercel.app" }],
      "destination": "https://velardtools.my.id/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "velard-tools-.*\\.vercel\\.app" }],
      "destination": "https://velardtools.my.id/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/assets/icons/favicon.ico" },
    { "source": "/apple-touch-icon.png", "destination": "/assets/icons/apple-touch-icon.png" },
    { "source": "/logo.png", "destination": "/assets/icons/logo.png" },
    { "source": "/og-image.jpg", "destination": "/assets/icons/og-image.jpg" },
    { "source": "/style.css", "destination": "/assets/css/style.css" },
    { "source": "/script.js", "destination": "/assets/js/app.js" },
    { "source": "/BACKGROUND%201.jpg", "destination": "/assets/images/bg/background-1.jpg" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), sync-xhr=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://cdn.jsdelivr.net https://www.googletagmanager.com https://www.google-analytics.com https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob: data:; connect-src 'self' blob: https://cdn.jsdelivr.net https://api.emailjs.com https://www.googletagmanager.com https://www.google-analytics.com https://analytics.google.com https://va.vercel-scripts.com; worker-src 'self' blob: https://cdn.jsdelivr.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(assets/css/style.css|assets/js/app.js|assets/js/thumbnail.js|assets/js/merge.js|assets/images/bg/background-1.jpg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}